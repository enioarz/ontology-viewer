Prefix(:=<https://example.org/animals#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(skos:=<http://www.w3.org/2004/02/skos/core#>)
Ontology(<https://example.org/animals>
  Annotation(rdfs:label "Animals ontology"@en)
  Annotation(rdfs:comment "A small example of classes and relationships."@en)
  Declaration(Class(:Animal))
  Declaration(Class(:Bird))
  Declaration(ObjectProperty(:hasParent))
  AnnotationAssertion(rdfs:label :Animal "Animal"@en)
  AnnotationAssertion(rdfs:label :Bird "Bird"@en)
  AnnotationAssertion(skos:definition :Bird "An animal with feathers."@en)
  AnnotationAssertion(skos:altLabel :Bird "Avian"@en)
  AnnotationAssertion(skos:example :Bird "A sparrow."@en)
  AnnotationAssertion(rdfs:label :hasParent "has parent"@en)
  SubClassOf(:Bird :Animal)
  ObjectPropertyDomain(:hasParent :Animal)
  ObjectPropertyRange(:hasParent :Animal)
)
